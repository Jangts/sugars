{
  "compilerOptions": {
    "target": "ES2025",
    "module": "NodeNext",
    "lib": [
      "ES2025",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "verbatimModuleSyntax": true,
    "composite": true,
    "declaration": true,
    "noEmitOnError": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true
  }
}
